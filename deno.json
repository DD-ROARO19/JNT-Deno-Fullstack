{
  "tasks": {
    "dev": "deno task dev:api & deno task dev:vite",
    "dev:api": "deno run --allow-env --allow-net --allow-read --allow-write api/main.ts",
    "dev:db": "deno run --allow-read --allow-write api/database/db_start.ts",
    "dev:vite": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run --allow-ffi=node_modules/.deno --allow-sys=osRelease,homedir npm:vite",
    "build": "deno run -A npm:vite build",
    "serve": {
      "command": "deno task dev:api",
      "description": "Run the build, and then start the API server",
      "dependencies": ["deno task build"]
    }
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@4.9.10",
    "@solidjs/router": "npm:@solidjs/router@0.15.3",
    "@floating-ui/dom": "npm:@floating-ui/dom@1.7.6",
    "solid-floating-ui": "npm:solid-floating-ui@0.3.1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "deno.ns"]
  }
}
